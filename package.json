{
  "name": "strs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run types && bunx --bun vite",
    "dev:mock": "bun run types && MOCK_GITHUB=dev/fixtures bunx --bun vite",
    "build": "bun run types && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "types": "bunx --bun elm-ts-interop --output src/Main.elm.d.ts",
    "font:logo": "bun dev/subset-logo-font.mjs",
    "favicon": "bun dev/favicon.mjs"
  },
  "devDependencies": {
    "@fontsource/major-mono-display": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "elm": "^0.19.3-0",
    "elm-ts-interop": "^0.0.8",
    "opentype.js": "^2.0.0",
    "subset-font": "^2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-elm": "^3.0.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "trustedDependencies": [
    "elm"
  ]
}
